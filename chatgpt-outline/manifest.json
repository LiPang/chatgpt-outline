{
  "manifest_version": 3,
  "name": "ChatGPT Outline",
  "version": "1.0.0",
  "description": "A quiet right-side conversation outline with prompt previews and heading navigation.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ChatGPT Outline",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "outline-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
